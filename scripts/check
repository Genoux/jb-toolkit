#!/usr/bin/env bash
# The one health check (R5). CI runs exactly this.
# Syntax of every script, shellcheck when installed, then an end-to-end run:
# a scaffolded project must pass its own jb check and its hooks must refuse
# what RULES.md forbids.
set -euo pipefail
cd "$(dirname "$0")/.."
root=$PWD

scripts=(bin/jb scripts/check templates/managed/.githooks/* templates/managed/.toolkit/version templates/stacks/*/scripts/check)
for f in "${scripts[@]}"; do
  case "$(head -1 "$f")" in *bash*) bash -n "$f" ;; *) sh -n "$f" ;; esac
done
if command -v shellcheck >/dev/null; then shellcheck -S warning "${scripts[@]}"; else echo "shellcheck not installed: skipped" >&2; fi

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
export GIT_AUTHOR_NAME=check GIT_AUTHOR_EMAIL=check@localhost GIT_COMMITTER_NAME=check GIT_COMMITTER_EMAIL=check@localhost

# A local repo stands in for GitHub, so the skill download is tested offline.
up=$tmp/upstream && mkdir -p "$up/skills/one/references" "$up/skills/two" "$up/agents"
printf -- '---\nname: one\n---\n' > "$up/skills/one/SKILL.md"; echo ref > "$up/skills/one/references/r.md"
printf -- '---\nname: two\n---\n' > "$up/skills/two/SKILL.md"
printf -- '---\nname: helper\n---\n' > "$up/agents/helper.md"
git -C "$up" init -q -b main && git -C "$up" add -A && git -C "$up" commit -q -m init
printf '# test list\nfile://%s skills/*\nfile://%s agents/helper.md\n' "$up" "$up" > "$tmp/skills.txt"
export JB_SKILLS_LIST=$tmp/skills.txt

JB_PROJECTS=$tmp "$root/bin/jb" new smoke --stack static >/dev/null
cd "$tmp/smoke"
for s in one two helper; do
  [ -f ".agents/skills/$s/SKILL.md" ] || { echo "skill $s not in .agents/skills" >&2; exit 1; }
  [ -f ".claude/skills/$s/SKILL.md" ] || { echo "skill $s not linked in .claude/skills" >&2; exit 1; }
done
[ "$(cat .claude/skills/one/references/r.md)" = ref ] || { echo "skill files not copied" >&2; exit 1; }
# the project's own skills: one only in .agents, one only in .claude
mkdir -p .agents/skills/mine && echo mine > .agents/skills/mine/SKILL.md
rm -rf .claude/skills/two && mkdir .claude/skills/two && echo mine > .claude/skills/two/SKILL.md
printf 'file://%s skills/one\nfile://%s skills/two\n' "$up" "$up" > "$tmp/skills.txt"
"$root/bin/jb" sync >/dev/null
[ ! -e .agents/skills/helper ] && [ ! -e .claude/skills/helper ] || { echo "sync kept a skill that left the list" >&2; exit 1; }
[ "$(cat .agents/skills/mine/SKILL.md)$(cat .claude/skills/two/SKILL.md)" = minemine ] || { echo "sync touched the project's own skills" >&2; exit 1; }
[ -f .agents/skills/two/.toolkit-source ] || { echo "a project's own Claude skill blocked the shared one" >&2; exit 1; }
printf 'file://%s/missing skills/one\n' "$tmp" > "$tmp/skills.txt"
"$root/bin/jb" sync >/dev/null 2>&1 || { echo "sync failed when a download failed" >&2; exit 1; }
[ -f .claude/skills/one/SKILL.md ] || { echo "a failed download removed a skill" >&2; exit 1; }
rm -rf .agents/skills/mine
[ -z "$(git status --porcelain --untracked-files=all)" ] || { echo "skills or sync left changes to commit" >&2; git status --porcelain >&2; exit 1; }
"$root/bin/jb" check >/dev/null || { "$root/bin/jb" check; exit 1; }
[ -z "$(JB_PROJECTS=$tmp "$root/bin/jb" session)" ] || { echo "session not silent on a clean project" >&2; exit 1; }
git config core.hooksPath ""
LC_ALL=C JB_PROJECTS=$tmp "$root/bin/jb" session | grep -q 'hooks' || { echo "session silent about a problem in the C locale" >&2; exit 1; }
git config core.hooksPath .githooks

refuses() { if "$@" >/dev/null 2>&1; then echo "hook accepted: $*" >&2; exit 1; fi; }
echo x > a.txt && git add a.txt
refuses git commit -m "feat: add a"                       # on main
git switch -q -c feat/smoke
refuses git commit -m "Added a."                          # not conventional
refuses git commit -m "feat: add a" -m "Co-authored-by: x <x@y>"
git commit -q -m "feat: add a"
git switch -q -c release/v0.2.0 && "$root/bin/jb" bump 0.2.0 >/dev/null
[ "$(.toolkit/version)" = 0.2.0 ] || { echo "bump failed" >&2; exit 1; }

# install into a fake HOME whose CLAUDE.md is a dotfiles symlink: running it
# twice must keep the link, the existing rules and exactly one block.
home=$tmp/home && mkdir -p "$home/.claude" "$tmp/dotfiles"
echo "# my rules" > "$tmp/dotfiles/CLAUDE.md"
ln -s "$tmp/dotfiles/CLAUDE.md" "$home/.claude/CLAUDE.md"
HOME=$home "$root/bin/jb" install >/dev/null 2>&1
HOME=$home "$root/bin/jb" install >/dev/null 2>&1
[ -L "$home/.claude/CLAUDE.md" ] || { echo "install replaced a symlinked CLAUDE.md" >&2; exit 1; }
[ "$(grep -c '>>> jb-toolkit' "$tmp/dotfiles/CLAUDE.md")" = 1 ] || { echo "install left other than one block in CLAUDE.md" >&2; exit 1; }
grep -qx '# my rules' "$tmp/dotfiles/CLAUDE.md" || { echo "install lost existing CLAUDE.md content" >&2; exit 1; }
# install leaves a launcher (not a symlink, which Git Bash turns into a copy)
# and links the toolkit's skills for Claude Code and for the other agents.
[ "$(HOME=$home "$home/.local/bin/jb" version)" = "$(tr -d '[:space:]' < "$root/VERSION")" ] || { echo "installed jb does not run the toolkit" >&2; exit 1; }
for s in "$root"/skills/*/; do
  s=$(basename "$s")
  [ -f "$home/.claude/skills/$s/SKILL.md" ] && [ -f "$home/.agents/skills/$s/SKILL.md" ] || { echo "install did not link skill $s" >&2; exit 1; }
done
echo "toolkit check passed"
