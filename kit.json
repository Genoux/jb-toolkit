{
  "agents": [
    {
      "id": "claude-code",
      "gentleAi": "claude-code",
      "impeccable": "claude"
    },
    {
      "id": "codex",
      "gentleAi": "codex",
      "impeccable": "codex"
    },
    {
      "id": "cursor",
      "gentleAi": "cursor",
      "impeccable": "cursor"
    },
    {
      "id": "gemini-cli",
      "gentleAi": "gemini-cli",
      "impeccable": "gemini"
    },
    {
      "id": "github-copilot",
      "gentleAi": "github-copilot-cli",
      "impeccable": "copilot"
    },
    {
      "id": "opencode",
      "gentleAi": "opencode",
      "impeccable": "opencode",
      "gentleAiNeeds": "opencode"
    }
  ],
  "items": [
    {
      "kind": "plugin",
      "name": "ponytail@ponytail",
      "source": "DietrichGebert/ponytail",
      "agent": "claude-code"
    },
    {
      "kind": "plugin",
      "name": "superpowers@claude-plugins-official",
      "source": "anthropics/claude-plugins-official",
      "agent": "claude-code"
    },
    {
      "kind": "plugin",
      "name": "engram@engram",
      "source": "Gentleman-Programming/engram",
      "agent": "claude-code"
    },
    {
      "kind": "plugin",
      "name": "egm@egm",
      "source": "google/elephant-goldfish-model",
      "agent": "claude-code"
    },
    {
      "kind": "skill-list",
      "name": "shared skills",
      "url": "https://raw.githubusercontent.com/Genoux/ib-toolkit/main/packages/standards/external-skills.txt"
    },
    {
      "kind": "command",
      "name": "impeccable",
      "present": "[ -f \"$HOME/.claude/skills/impeccable/SKILL.md\" ]",
      "install": "cd \"$HOME\" && npx --yes impeccable@4.8.0 install --yes --user --providers={agents:impeccable} </dev/null"
    },
    {
      "kind": "command",
      "name": "caveman",
      "present": "[ \"$(cave --version 2>/dev/null | jq -r .version 2>/dev/null)\" = 4.1.0 ] && [ -x \"$HOME/.caveman/bin/caveman-mcp\" ]",
      "install": "cd \"$HOME\" && npm install -g --silent @caveman-ai/cli@4.1.0 </dev/null && cave setup --yes </dev/null"
    },
    {
      "kind": "release",
      "name": "rtk",
      "repo": "rtk-ai/rtk",
      "version": "0.45.0",
      "after": "rtk init -g --auto-patch",
      "assets": {
        "darwin-arm64": {
          "file": "rtk-aarch64-apple-darwin.tar.gz",
          "sha256": "064151cfc2d50b24d810b06a0af2e41b9c945e83534e4c438c3d3eae607fc3f4"
        },
        "darwin-x86_64": {
          "file": "rtk-x86_64-apple-darwin.tar.gz",
          "sha256": "9ea02f889d5a2779e4fb700df4587824303c5a57cda22e903e30058079fca0ef"
        },
        "linux-aarch64": {
          "file": "rtk-aarch64-unknown-linux-gnu.tar.gz",
          "sha256": "80a746dd305ef944ff50ef011ae4ce3878dd5ba88dfe35d859d05498191637c3"
        },
        "linux-x86_64": {
          "file": "rtk-x86_64-unknown-linux-musl.tar.gz",
          "sha256": "c4c036fbf181fc55ef329786c8c17e0d427972b053b825944d968a6aafef1ba4"
        }
      }
    },
    {
      "kind": "release",
      "name": "gentle-ai",
      "repo": "Gentleman-Programming/gentle-ai",
      "version": "4.4.0",
      "assets": {
        "darwin-arm64": {
          "file": "gentle-ai_4.4.0_darwin_arm64.tar.gz",
          "sha256": "b6e00957eb81115f18e33197ae2035f75812a624c6d53e72826ecf7b4a635539"
        },
        "darwin-x86_64": {
          "file": "gentle-ai_4.4.0_darwin_amd64.tar.gz",
          "sha256": "95686ea30615516aa29ebb6257227b1cdd4c67649dff63ec7adb576ca26a678d"
        },
        "linux-aarch64": {
          "file": "gentle-ai_4.4.0_linux_arm64.tar.gz",
          "sha256": "2d8874464cbe54b66a77d7c9fe66ce577933de00936ed1a035c81de6406a95fc"
        },
        "linux-x86_64": {
          "file": "gentle-ai_4.4.0_linux_amd64.tar.gz",
          "sha256": "1f72ca13b32e87cb7f65b29e7fae6df4490b53d69d4763cdf23e944165880cd6"
        }
      }
    },
    {
      "kind": "command",
      "name": "gentle-ai config",
      "writesRules": true,
      "present": "gentle_ai_configured",
      "install": "gentle-ai install --agent {agents:gentleAi} --component persona,engram,skills --persona gentleman --skill go-testing,gentle-ai-bench,skill-creator,skill-improver,judgment-day,skill-registry,chained-pr,cognitive-doc-design,comment-writer,work-unit-commits,rdd-defect-workflow,systemic-issue-triage"
    },
    {
      "kind": "command",
      "name": "gentle-ai telemetry off",
      "present": "! command -v gentle-ai >/dev/null || [ \"$(gentle-ai telemetry status --json 2>/dev/null | jq -r .enabled)\" = false ]",
      "install": "gentle-ai telemetry disable"
    }
  ]
}
